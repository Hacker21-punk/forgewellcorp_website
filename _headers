/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(self "https://www.google.com" "https://maps.google.com"), gyroscope=(), microphone=(), payment=(), usb=()
  Cross-Origin-Resource-Policy: cross-origin
  X-DNS-Prefetch-Control: off
  X-Permitted-Cross-Domain-Policies: none
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob: https://ik.imagekit.io https://img.youtube.com https://i.ytimg.com https://*.google.com https://*.gstatic.com https://*.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://www.youtube.com https://s.ytimg.com https://*.google.com https://*.gstatic.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; media-src 'self' blob: https://forgewell.s3.ap-south-1.amazonaws.com https://*.amazonaws.com; frame-src 'self' https://www.youtube.com https://youtube.com https://www.google.com https://maps.google.com https://*.google.com; connect-src 'self' https://forgewell.s3.ap-south-1.amazonaws.com https://*.amazonaws.com https://*.google.com https://*.gstatic.com https://*.googleapis.com https://api.github.com https://gist.githubusercontent.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests; block-all-mixed-content

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate

/contact.html
  Cache-Control: public, max-age=0, must-revalidate

/trueprogress.html
  Cache-Control: public, max-age=0, must-revalidate

/login.html
  Cache-Control: public, max-age=0, must-revalidate

/reset-password.html
  Cache-Control: public, max-age=0, must-revalidate

/dashboard.html
  Cache-Control: public, max-age=0, must-revalidate

/survey.html
  Cache-Control: public, max-age=0, must-revalidate

/video.html
  Cache-Control: public, max-age=0, must-revalidate

/styles.css
  Cache-Control: public, max-age=31536000, immutable

/script.js
  Cache-Control: public, max-age=31536000, immutable

/theme.js
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
